# The branch this repository already had.
#
# Spelled out rather than left implied, so that `divergent` is a peer of
# `master` instead of "the absence of one". Nothing here changes any file: the
# branch already carries this identity, and a build with no branch selected
# falls back to it.
#
# Schema and how to add a branch: branches/README.md

BRANCH_NAME="master"
BRANCH_DESCRIPTION="The upstream-tracking branch; the identity the repository already has."

# Unused while APPLY_IDENTITY is false.
DISPLAY_NAME="anImestream"

# Empty means "leave the project's own bundle id alone".
BUNDLE_ID=""

# Empty means "leave pubspec.yaml's description alone".
PUBSPEC_DESCRIPTION=""

# false = apply-identity.sh writes nothing at all.
APPLY_IDENTITY="false"
