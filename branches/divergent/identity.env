# The `divergent` branch: the standalone build.
#
# This branch is the one that stops tracking upstream. It builds the same Dart
# source as master -- the Dart package id cannot change, see
# PUBSPEC_DESCRIPTION below -- but ships under its own display name, its own iOS
# bundle id and its own icon, so it installs alongside a master build on the
# same device.
#
# The identity is applied to the working tree at build time by
# branches/apply-identity.sh rather than committed, and that is deliberate:
# ios/Runner.xcodeproj/project.pbxproj is ~90KB of generated Xcode plist, so a
# bundle-id change committed to the branch would conflict on every upstream
# merge. Applying it at build time keeps the branch thin and the diff reviewable.
#
# Schema and how to add a branch: branches/README.md

BRANCH_NAME="divergent"
BRANCH_DESCRIPTION="The standalone branch; its own display name, bundle id and icon."

# What the iOS home screen shows.
DISPLAY_NAME="anImestream-divergent"

# The iOS bundle identifier. Written into ios/**/project.pbxproj by
# branches/apply-identity.sh. RunnerTests keeps its `.RunnerTests` suffix, so the
# test target does not collapse onto the app's id.
BUNDLE_ID="divergent.sofikuw.anImestream"

# Rewritten into pubspec.yaml's description. Note that pubspec.yaml's `name:` is
# deliberately NOT touched: it is the Dart package id that every
# `package:animestream/...` import in lib/ uses, and Dart package ids cannot
# contain dots or capitals, so `divergent.sofikuw.anImestream` cannot live there.
# That string is a bundle id -- the line above -- not a package name.
PUBSPEC_DESCRIPTION="Standalone divergent iOS build of anImestream (manga + anime)."

APPLY_IDENTITY="true"
